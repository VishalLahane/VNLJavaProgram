// Function to find the index of the least recently used page
int findLRU(int time[], int n) {
    int minimum = time[0], pos = 0;
    for (int i = 1; i < n; ++i) {
        if (time[i] < minimum) {
            minimum = time[i];
            pos = i;
        }
    }
    return pos;
}

// Function to simulate LRU page replacement
void lruPageReplacement(int pages[], int n, int frames) {
    int frame[MAX_FRAMES], time[MAX_FRAMES];
    int pageFaults = 0;

    // Initialize frames and time arrays
    for (int i = 0; i < frames; ++i) {
        frame[i] = -1; // Indicates an empty frame
        time[i] = 0;   // Initialize time for LRU tracking
    }

    for (int i = 0; i < n; ++i) {
        int j;
