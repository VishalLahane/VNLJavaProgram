                pageFound = 1; // Page is found in frame
                time[j] = i;   // Update time of the page
                break;
            }
        }

        // If page is not found in any frame
        if (!pageFound) {
            int lruIndex = findLRU(time, frames); // Find the LRU page
            frame[lruIndex] = pages[i];           // Replace it with the new page
